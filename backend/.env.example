# Copia in ".env" nella cartella backend/ e personalizza i valori.

NODE_ENV=development
PORT=4000

# Deve combaciare con le credenziali definite nel .env di root usate da docker-compose
MONGO_URI=mongodb://admin:changeme@mongodb:27017/bmcons?authSource=admin

# Origine autorizzata per le richieste CORS (URL del frontend)
CORS_ORIGIN=http://localhost:5173

# Segreti JWT: generane di robusti, es. con `openssl rand -hex 64`
JWT_ACCESS_SECRET=change_this_access_secret
JWT_REFRESH_SECRET=change_this_refresh_secret
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d
REFRESH_COOKIE_NAME=refreshToken

# Utente amministratore creato dallo script di seed (npm run seed)
ADMIN_NAME=Amministratore
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChangeMe123!

# Chiave API Anthropic (https://console.anthropic.com/)
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxx
