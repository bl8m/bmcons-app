# Variabili usate da docker-compose.yml per l'infrastruttura condivisa.
# Copia questo file in ".env" nella root del progetto e personalizza i valori.

# --- MongoDB ---
MONGO_ROOT_USERNAME=admin
MONGO_ROOT_PASSWORD=changeme
MONGO_DB_NAME=bmcons

# --- Mongo Express (UI di amministrazione DB, solo per sviluppo) ---
MONGO_EXPRESS_USERNAME=admin
MONGO_EXPRESS_PASSWORD=changeme

# --- Porte esposte sull'host ---
BACKEND_PORT=4000
FRONTEND_PORT=5173
MONGO_EXPRESS_PORT=8081
