# Variabili d'ambiente dell'intero progetto (unico file, usato da Docker
# Compose per i container backend/frontend e, in sviluppo senza Docker, letto
# direttamente da backend (dotenv) e frontend (Vite: vedi vite.config.js).
# Copia questo file in ".env" nella root e personalizza i valori.

# ============================================================
# Infrastruttura (Docker Compose / MongoDB / Mongo Express)
# ============================================================
MONGO_ROOT_USERNAME=admin
MONGO_ROOT_PASSWORD=changeme
MONGO_DB_NAME=bmcons

MONGO_EXPRESS_USERNAME=admin
MONGO_EXPRESS_PASSWORD=changeme

BACKEND_PORT=4000
FRONTEND_PORT=5173
MONGO_EXPRESS_PORT=8081

# ============================================================
# Backend
# ============================================================
NODE_ENV=development
PORT=4000

# Usato solo in sviluppo SENZA Docker (host "localhost" invece del nome
# "mongodb" interno alla rete Docker). Quando si usa "docker compose up",
# docker-compose.yml sovrascrive questo valore componendolo automaticamente
# dalle credenziali MONGO_ROOT_* qui sopra, così non serve più tenerle
# sincronizzate a mano.
MONGO_URI=mongodb://admin:changeme@localhost:27017/bmcons?authSource=admin

# Origine autorizzata per le richieste CORS (URL del frontend)
CORS_ORIGIN=http://localhost:5173

# Segreti JWT: generane di robusti, es. con `openssl rand -hex 64`
JWT_ACCESS_SECRET=change_this_access_secret
JWT_REFRESH_SECRET=change_this_refresh_secret
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d
REFRESH_COOKIE_NAME=refreshToken

# Utente amministratore creato dallo script di seed (npm run seed)
ADMIN_NAME=Amministratore
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChangeMe123!

# Chiave API Anthropic (https://console.anthropic.com/)
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxx

# ============================================================
# Frontend
# ============================================================
VITE_API_URL=http://localhost:4000/api
