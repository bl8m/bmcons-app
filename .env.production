# Valori per l'ambiente di PRODUZIONE. Copia questo file (o incollane il
# contenuto nella sezione "Environment" di Dokploy) e sostituisci tutti i
# segnaposto CAMBIAMI_* — non è pensato per essere usato così com'è, ed è
# escluso da git (vedi .gitignore: "!*.env.example" è l'unica eccezione).
#
# Rispetto a .env.example (sviluppo), qui cambiano soprattutto: NODE_ENV,
# CORS_ORIGIN/VITE_API_URL (dominio reale invece di localhost) e tutti i
# segreti/password, che devono essere DIVERSI da quelli di sviluppo.

# ============================================================
# Infrastruttura (Docker Compose / MongoDB / Mongo Express)
# ============================================================
MONGO_ROOT_USERNAME=admin
MONGO_ROOT_PASSWORD=CAMBIAMI_password_robusta_diversa_dallo_sviluppo
MONGO_DB_NAME=bmcons

# Mongo Express (UI di amministrazione DB): sconsigliato in produzione. Se il
# compose che usi in produzione non include questo servizio, ignora le due
# righe sotto; se lo includi comunque, assicurati che non sia raggiungibile
# pubblicamente (nessun dominio esposto via Dokploy, al più un tunnel SSH).
MONGO_EXPRESS_USERNAME=admin
MONGO_EXPRESS_PASSWORD=CAMBIAMI_password_robusta

# Porte interne ai container: con Dokploy il traffico pubblico passa dal suo
# reverse proxy (Traefik) verso la porta interna del servizio, non da queste
# porte pubblicate sull'host — lasciale ai valori di default a meno che la
# tua configurazione Dokploy richieda diversamente.
BACKEND_PORT=4000
FRONTEND_PORT=5173
MONGO_EXPRESS_PORT=8081

# ============================================================
# Backend
# ============================================================
# Importante: abilita il flag Secure sul cookie di refresh (richiede HTTPS,
# che con Dokploy/Traefik è tipicamente automatico via Let's Encrypt).
NODE_ENV=production
PORT=4000

# Se il tuo compose di produzione ricalcola MONGO_URI automaticamente dalle
# credenziali MONGO_ROOT_* (come fa l'attuale docker-compose.yml per il
# target "dev"), questa riga viene sovrascritta e serve solo da fallback.
MONGO_URI=mongodb://admin:CAMBIAMI_password_robusta_diversa_dallo_sviluppo@mongodb:27017/bmcons?authSource=admin

# Dominio pubblico reale del frontend, con https — non localhost.
CORS_ORIGIN=https://CAMBIAMI-tuo-dominio.it

# Segreti JWT: DEVONO essere diversi da quelli di sviluppo. Generali con:
# openssl rand -hex 64
JWT_ACCESS_SECRET=CAMBIAMI_genera_un_nuovo_segreto
JWT_REFRESH_SECRET=CAMBIAMI_genera_un_nuovo_segreto
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d
REFRESH_COOKIE_NAME=refreshToken

# Amministratore iniziale creato da "npm run seed" in produzione.
ADMIN_NAME=Amministratore
ADMIN_EMAIL=CAMBIAMI@tuo-dominio.it
ADMIN_PASSWORD=CAMBIAMI_password_robusta

# Puoi riusare la stessa chiave di sviluppo o crearne una dedicata alla produzione.
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxx

# ============================================================
# Frontend
# ============================================================
# URL pubblico reale delle API (https, dominio reale).
#
# ATTENZIONE: Vite "incorpora" questo valore nel bundle statico al momento
# della build (npm run build), non a runtime — impostarlo solo come variabile
# del container già costruito NON basta. Va passato come build arg
# (VITE_API_URL, vedi frontend/Dockerfile e docker-compose) nel momento in
# cui l'immagine frontend viene costruita.
VITE_API_URL=https://CAMBIAMI-tuo-dominio.it/api
